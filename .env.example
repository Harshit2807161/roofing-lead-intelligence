# Copy to .env and fill in. .env is git-ignored.
DATABASE_URL=postgresql+psycopg://leads:leads@localhost:5433/leads

# GAF's public search key (the one gaf.com's own pages send; visible in the page's data-coveo attribute)
COVEO_API_KEY=

# LLM providers (used from the scoring/insight phase on)
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
SMALL_MODEL=gpt-6-luna
MODEL=gpt-6.1-sol

# P1 (F13): false = all 426 contractors in the circle instead of the 85 the page shows
SEARCH_RECOMMENDED_ONLY=true
